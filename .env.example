# Sklep (Spartans ASG.dc.html) dociąga Supabase z CDN w przeglądarce, więc te
# wartości trafiają docelowo do prostego pliku konfiguracyjnego (np.
# supabase-config.js) wczytywanego obok support.js — NIGDY do repo z prawdziwymi
# wartościami, tylko ten plik .env.example jako wzór.
#
# Znajdziesz je w Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NIGDY nie wklejaj tutaj service_role key ani hasła do bazy danych.
# Te dwie wartości powyżej to jedyne, które wolno umieścić w kodzie
# wysyłanym do przeglądarki.
